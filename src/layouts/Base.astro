---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource/six-caps/latin-400.css";
import "../styles/global.css";
import { url, href, SUGGEST_FORM } from "../lib/site";
import { LOCALES, langOf, t } from "../i18n/ui";

const lang = langOf(Astro);
const T = t(lang);
// `path` is this page's address without the language prefix, so the switcher can link to the same page in the other language
// image: the share preview (an og/*.jpg made at build time, see src/pages/og/); jsonld: structured data for search engines;
// noindex: pages that must not show up in search (404)
const { title, description = T("meta.description"), current = "events", path = "", image = "og/site.jpg", jsonld = [], noindex = false } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const pageUrl = abs(href(lang, path));
// every page says what site it belongs to; pages add their own items (breadcrumbs, organization)
const ld = { "@context": "https://schema.org", "@graph": [{ "@type": "WebSite", name: "Events Lviv", url: abs(href(lang)), inLanguage: lang }, ...[jsonld].flat()] };
// the Lviv mark is a white-on-transparent mask, so it takes the text colour of either theme
const logoMask = `--logo:url(${url("brand/logo.webp")})`;
const NAV = [
  { to: "", label: T("nav.home"), id: "home" },
  { to: "events/", label: T("nav.events"), id: "events" },
  { to: "organizations/", label: T("nav.orgs"), id: "organizations" },
  { to: "calendar/", label: T("nav.calendar"), id: "calendar" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Google Search Console ownership check for https://events-lviv.vercel.app/ */}
    <meta name="google-site-verification" content="HnW95rNOxaTVfZutqlzEixuJ6WrAydV_5nV5eqtpVuo" />
    {/* canonical, hreflang and share tags need absolute URLs, so they come from `site` in astro.config.mjs */}
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={pageUrl} />
        {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(href(l, path))} />)}
        <link rel="alternate" hreflang="x-default" href={abs(href("uk", path))} />
      </>
    )}
    {/* the preview card in Telegram, Facebook, Viber, X and the like */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Events Lviv" />
    <meta property="og:title" content={title.replace(/ \| Events Lviv$/, "")} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={abs(url(image))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "uk" ? "uk_UA" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "uk" ? "en_US" : "uk_UA"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />
    <link rel="icon" type="image/png" href={url("favicon.png")} />
    {/* the phone's status bar takes this colour; it follows the site theme, not only the system one */}
    <meta name="theme-color" content="#0b0b0e" />
    <script is:inline>
      // Runs before paint so the page never flashes the wrong theme; a saved choice beats the system setting.
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      } catch {}
      if (document.documentElement.dataset.theme === "light") document.querySelector('meta[name="theme-color"]').content = "#f5f3ee";
    </script>
  </head>
  <body id="top">
    <header class="top">
      <a class="logo" href={href(lang)} aria-label="Events Lviv"><span class="mark" style={logoMask} aria-hidden="true"></span><span class="logo-text" aria-hidden="true">Events</span></a>
      <nav class="main-nav" aria-label={T("nav.aria")}>
        {NAV.map((n) => <a class={`to-${n.id}`} href={href(lang, n.to)} aria-current={current === n.id ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <div class="tools">
        <nav class="lang" aria-label={T("lang.aria")}>
          {LOCALES.map((l) => (
            <a href={href(l, path)} lang={l} hreflang={l} aria-current={l === lang ? "true" : undefined} aria-label={l === "uk" ? "Українська" : "English"}>{l === "uk" ? "UA" : "EN"}</a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" aria-label={T("theme.toggle")} aria-pressed="false">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
        </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="foot">
      <div class="foot-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="foot-inner">
        <div>
          <a class="logo" href={href(lang)} aria-label="Events Lviv"><span class="mark" style={logoMask} aria-hidden="true"></span><span class="logo-text" aria-hidden="true">Events</span></a>
          <p>{T("foot.about")}</p>
        </div>
        <nav aria-label={T("foot.sectionsAria")}>
          <h2>{T("foot.sections")}</h2>
          <ul>{NAV.map((n) => <li><a href={href(lang, n.to)}>{n.label}</a></li>)}</ul>
        </nav>
        <div>
          <h2>{T("foot.missingTitle")}</h2>
          <p>{T("foot.missingText")}</p>
          <div class="foot-ctas">
            <a class="foot-cta" href={SUGGEST_FORM} target="_blank" rel="noopener">{T("cta.suggest")}</a>
            <a class="foot-cta" href={href(lang, "feedback/")}>{T("cta.report")}</a>
          </div>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} TheDeiw</span>
        <a href="#top">{T("foot.top")}</a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
      const sync = () => toggle.setAttribute("aria-pressed", String(root.dataset.theme === "light"));
      sync();
      toggle.addEventListener("click", () => {
        const apply = () => {
          root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
          document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = root.dataset.theme === "light" ? "#f5f3ee" : "#0b0b0e";
          try {
            localStorage.setItem("theme", root.dataset.theme);
          } catch {}
          sync();
        };
        // a cross-fade instead of an abrupt light/dark flash, where the browser can do it
        if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.startViewTransition(apply);
        else apply();
      });

      // phones: the header gets out of the way while reading down and comes back on the first scroll up (CSS only moves it under 720px)
      const header = document.querySelector<HTMLElement>(".top")!;
      let lastY = scrollY;
      addEventListener(
        "scroll",
        () => {
          const y = scrollY;
          if (Math.abs(y - lastY) < 6) return;
          header.classList.toggle("away", y > lastY && y > 160);
          lastY = y;
        },
        { passive: true },
      );
      header.addEventListener("focusin", () => header.classList.remove("away"));
      // on the narrowest phones the links can scroll sideways; keep the current page's link in view
      header.querySelector(".main-nav [aria-current]")?.scrollIntoView({ block: "nearest", inline: "nearest" });
    </script>
  </body>
</html>
