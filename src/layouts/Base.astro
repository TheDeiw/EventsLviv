---
import "@fontsource-variable/geologica/wght.css";
import "../styles/global.css";
import { url, href } from "../lib/site";
import { LOCALES, langOf, t } from "../i18n/ui";

const lang = langOf(Astro);
const T = t(lang);
// `path` is this page's address without the language prefix, so the switcher can link to the same page in the other language
const { title, description = T("meta.description"), current = "events", path = "" } = Astro.props;
const NAV = [
  { to: "", label: T("nav.home"), id: "home" },
  { to: "events/", label: T("nav.events"), id: "events" },
  { to: "organizations/", label: T("nav.orgs"), id: "organizations" },
  { to: "calendar/", label: T("nav.calendar"), id: "calendar" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* canonical and hreflang need absolute URLs, so they come from `site` in astro.config.mjs */}
    {Astro.site && <link rel="canonical" href={new URL(href(lang, path), Astro.site).href} />}
    {Astro.site && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, path), Astro.site).href} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(href("uk", path), Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    {/* the phone's status bar takes this colour; it follows the site theme, not only the system one */}
    <meta name="theme-color" content="#0b0b0e" />
    <script is:inline>
      // Runs before paint so the page never flashes the wrong theme; a saved choice beats the system setting.
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      } catch {}
      if (document.documentElement.dataset.theme === "light") document.querySelector('meta[name="theme-color"]').content = "#f5f3ee";
    </script>
  </head>
  <body id="top">
    <header class="top">
      <a class="logo" href={href(lang)}><span class="spires" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span class="logo-text">Events Lviv</span></a>
      <nav class="main-nav" aria-label={T("nav.aria")}>
        {NAV.map((n) => <a class={`to-${n.id}`} href={href(lang, n.to)} aria-current={current === n.id ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <div class="tools">
        <nav class="lang" aria-label={T("lang.aria")}>
          {LOCALES.map((l) => (
            <a href={href(l, path)} lang={l} hreflang={l} aria-current={l === lang ? "true" : undefined} aria-label={l === "uk" ? "Українська" : "English"}>{l === "uk" ? "UA" : "EN"}</a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" aria-label={T("theme.toggle")} aria-pressed="false">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
        </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="foot">
      <div class="foot-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="foot-inner">
        <div>
          <a class="logo" href={href(lang)}><span class="spires" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>Events Lviv</a>
          <p>{T("foot.about")}</p>
        </div>
        <nav aria-label={T("foot.sectionsAria")}>
          <h2>{T("foot.sections")}</h2>
          <ul>{NAV.map((n) => <li><a href={href(lang, n.to)}>{n.label}</a></li>)}</ul>
        </nav>
        <div>
          <h2>{T("foot.missingTitle")}</h2>
          <p>{T("foot.missingText")}</p>
          <a class="foot-cta" href="https://www.instagram.com/the_deiw_/" target="_blank" rel="noopener">{T("cta.instagram")}</a>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} TheDeiw</span>
        <a href="#top">{T("foot.top")}</a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
      const sync = () => toggle.setAttribute("aria-pressed", String(root.dataset.theme === "light"));
      sync();
      toggle.addEventListener("click", () => {
        const apply = () => {
          root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
          document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = root.dataset.theme === "light" ? "#f5f3ee" : "#0b0b0e";
          try {
            localStorage.setItem("theme", root.dataset.theme);
          } catch {}
          sync();
        };
        // a cross-fade instead of an abrupt light/dark flash, where the browser can do it
        if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.startViewTransition(apply);
        else apply();
      });

      // phones: the header gets out of the way while reading down and comes back on the first scroll up (CSS only moves it under 720px)
      const header = document.querySelector<HTMLElement>(".top")!;
      let lastY = scrollY;
      addEventListener(
        "scroll",
        () => {
          const y = scrollY;
          if (Math.abs(y - lastY) < 6) return;
          header.classList.toggle("away", y > lastY && y > 160);
          lastY = y;
        },
        { passive: true },
      );
      header.addEventListener("focusin", () => header.classList.remove("away"));
      // on the narrowest phones the links can scroll sideways; keep the current page's link in view
      header.querySelector(".main-nav [aria-current]")?.scrollIntoView({ block: "nearest", inline: "nearest" });
    </script>
  </body>
</html>
