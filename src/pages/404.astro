---
import Base from "../layouts/Base.astro";
import { href } from "../lib/site";

// Vercel serves this for any missing address in either language, so it speaks both
---

<Base title="Сторінку не знайдено · Page not found | Events Lviv" noindex current="">
  <main class="nf">
    <p class="code">404</p>
    <h1>Сторінку не знайдено</h1>
    <p>Можливо, подію прибрали зі списку або адресу набрано з помилкою.</p>
    <p class="links"><a href={href("uk", "events/")}>Усі події</a> · <a href={href("uk")}>На головну</a></p>
    <h2 lang="en">Page not found</h2>
    <p lang="en">The event may have been removed from the list, or the address has a typo.</p>
    <p class="links" lang="en"><a href={href("en", "events/")}>All events</a> · <a href={href("en")}>Home</a></p>
  </main>
</Base>

<style>
  .nf { max-width: 640px; margin: 0 auto; padding: 80px 32px 96px; }
  .code { margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.1em; color: var(--muted); }
  h1, h2 { margin: 8px 0 12px; font-size: clamp(28px, 4vw, 40px); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
  h2 { margin-top: 48px; font-size: 24px; }
  p { margin: 0 0 12px; }
  .links a { color: var(--text); text-underline-offset: 3px; }
  @media (max-width: 600px) { .nf { padding: 48px 16px 64px; } }
</style>
