---
import Base from "../layouts/Base.astro";
import { events, organizations, topics, url } from "../lib/site";

// depth: d1 drifts slowest on scroll, d3 fastest; side decides which way it slides in
const RIBBONS = [
  { src: "ribbon-purple.webp", w: 1000, h: 270, cls: "r-purple d1 left" },
  { src: "ribbon-green.webp", w: 1000, h: 392, cls: "r-green d2 left" },
  { src: "ribbon-yellow.webp", w: 744, h: 988, cls: "r-yellow d3 left" },
  { src: "ribbon-blue.webp", w: 1000, h: 431, cls: "r-blue d1 right" },
  { src: "ribbon-red.webp", w: 1000, h: 488, cls: "r-red d3 right" },
];
const STATS = [
  { n: events.length, label: "подій", c: "var(--spire-1)" },
  { n: organizations.length, label: "організацій", c: "var(--spire-4)" },
  { n: topics.length, label: "тематик", c: "var(--spire-5)" },
];
const NOT = [
  "Події від університетів (наприклад, Весна політехніки, день кар’єри)",
  "Концерти окремих виконавців",
  "Релігійні події (наприклад, ЛЕВЕЛ)",
  "Табори, курси, стажування",
  "Різні Speaking Clubs і таке інше",
];
const ME = [
  { title: "TheDeiw Portfolio", href: "https://thedeiw.github.io/TheDeiwPortfolio/" },
  { title: "Instagram", href: "https://www.instagram.com/the_deiw_/" },
  { title: "LinkedIn", href: "https://www.linkedin.com/in/dmytro-chekhovskyi-81baba291/" },
];
---

<Base title="Events Lviv — щорічні події у Львові" description="Список щорічних подій у Львові: що тут є, чого немає і хто це робить." current="home">
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="stage" aria-hidden="true">
        {RIBBONS.map((r, i) => (
          <div class={`ribbon ${r.cls}`} style={`--delay:${120 + i * 70}ms`}>
            <img src={url(`hero/${r.src}`)} width={r.w} height={r.h} alt="" />
          </div>
        ))}
      </div>
      <div class="copy">
        <div class="disc" aria-hidden="true">
          <img src={url("hero/disc.webp")} width="792" height="900" alt="" fetchpriority="high" />
        </div>
        <h1 id="hero-title">Events Lviv</h1>
        <p class="sub">Щорічні події у Львові</p>
        <p class="kinds">Фестивалі · Конференції · Форуми · Ініціативи</p>
        <div class="actions">
          <a class="cta" href={url("events/")}>Переглянути події</a>
          <a class="cta ghost" href="#about">Про проєкт</a>
        </div>
      </div>
    </section>

    <div class="about" id="about">
      <section class="intro" aria-labelledby="about-title">
        <p class="eyebrow" id="about-title">Про проєкт</p>
        <p class="lead">
          Всім привіт. Вітаю у списку львівських подій. Список був створений для людей, які бажають дізнатись більше про те,
          що відбувається у Львові протягом року. Мета — поширити інформацію про різні ініціативи та показати, що Львів — це
          місто ініціатив, розвитку та майбутнього.
        </p>
        <ul class="stats">
          {STATS.map((s) => <li style={`--c:${s.c}`}><b>{s.n}</b><span>{s.label}</span></li>)}
        </ul>
      </section>

      <div class="duo">
        <section class="panel" style="--c:var(--spire-4)">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </span>
          <h2>Що тут можна побачити</h2>
          <p>
            Щорічні події, фестивалі, форуми, збори, конференції, які охоплюють велику частину людей (як вузькопрофільних у
            чомусь, так і на загал). Події однієї організації зібрані на її сторінці, окремі унікальні події подані самостійно.
          </p>
        </section>
        <section class="panel" style="--c:var(--spire-3)">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
          </span>
          <h2>Що я можу дізнатись про подію</h2>
          <p>
            Кожна подія розписана за шаблоном: невеликий опис, цільова аудиторія, місце проведення, час та умови входу. Для
            детальнішої інформації є посилання на подію або на компанії-організаторів. До кожної події надані фотографії для
            кращого розуміння.
          </p>
        </section>
      </div>

      <div class="split">
        <section class="panel nots" style="--c:var(--spire-2)">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg>
          </span>
          <h2>Чого тут немає</h2>
          <p>У цьому списку ви не зможете знайти таких подій:</p>
          <ul>{NOT.map((t) => <li>{t}</li>)}</ul>
        </section>
        <aside class="panel" style="--c:var(--spire-1)">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </span>
          <h2>Проєкт створений лише на волонтерських засадах</h2>
          <p>
            Список оновлюється нерегулярно, але автор старається підтримувати його додаванням нових подій та підтримуванням
            достовірності інформації. Відкритий для скарг та пропозицій. Ми всі люди і помилки можуть бути. Поставтесь, будь
            ласка, з розумінням.
          </p>
        </aside>
      </div>

      <section class="author" aria-labelledby="author-title">
        <img src={url("images/about/author.webp")} alt="" width="140" height="134" loading="lazy" />
        <div>
          <p class="eyebrow">Про автора</p>
          <h2 id="author-title">TheDeiw</h2>
          <p>
            Привіт! Мене звати TheDeiw. Я живу у Львові й обожнюю його ритм. Мені завжди бракувало єдиного місця, де були б
            зібрані всі круті періодичні події міста, тому я вирішив створити його сам. Цей список — мій особистий проєкт,
            створений з любов’ю до Львова та його людей.
          </p>
          <ul class="links">
            {ME.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.title}</a></li>)}
          </ul>
        </div>
      </section>

      <section class="join">
        <div>
          <h2>Нумо разом створимо найкращий гід по івентах Львова!</h2>
          <p>
            Цей проєкт почався з моєї ініціативи, але я вірю, що кращим він стане лише завдяки вам. Найкращим способом буде
            зв’язатись через Instagram.
          </p>
        </div>
        <a class="cta" href="https://www.instagram.com/the_deiw_/" target="_blank" rel="noopener">Написати в Instagram</a>
      </section>
    </div>
  </main>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative; overflow: clip; isolation: isolate;
    display: grid; place-items: center;
    min-height: min(calc(100svh - 76px), 880px); padding: 40px 16px 72px;
  }
  .stage { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ribbon { position: absolute; }
  .ribbon img { display: block; width: 100%; height: auto; }
  .r-purple { left: -7%; top: 3%; width: clamp(240px, 31vw, 500px); }
  .r-purple img { rotate: -12deg; }
  .r-green { left: -9%; top: 44%; width: clamp(240px, 30vw, 480px); }
  .r-green img { rotate: 16deg; }
  .r-yellow { left: 9%; bottom: -12%; width: clamp(120px, 12vw, 200px); }
  .r-yellow img { rotate: -16deg; }
  .r-blue { right: -6%; top: 7%; width: clamp(240px, 30vw, 480px); }
  .r-blue img { rotate: 12deg; }
  .r-red { right: -11%; bottom: 4%; width: clamp(260px, 34vw, 540px); }
  .r-red img { rotate: -10deg; }

  .copy { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .disc { width: clamp(190px, 22vw, 300px); margin-bottom: 18px; }
  .disc img { display: block; width: 100%; height: auto; }
  h1 { margin: 0; font-size: clamp(46px, 7.4vw, 92px); font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--hero-title); }
  .sub { margin: 14px 0 0; font-size: clamp(14px, 1.6vw, 18px); letter-spacing: 0.28em; color: var(--muted); }
  .kinds { margin: 10px 0 0; font-size: 13px; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  .cta {
    display: inline-block; padding: 12px 22px; border-radius: 99px; font-weight: 500; text-decoration: none;
    background: var(--text); color: var(--bg); border: 1px solid var(--text);
    transition: transform 160ms var(--ease-out), opacity 150ms ease, border-color 150ms ease;
  }
  .cta.ghost { background: transparent; color: var(--text); border-color: var(--line); }
  .cta:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: no-preference) {
    .ribbon img { animation: ribbon-in 1000ms var(--ease-out) var(--delay) both; }
    .left img { --from: -56px; }
    .right img { --from: 56px; }
    .disc img { animation: disc-in 900ms var(--ease-out) both; }
    .copy > :not(.disc) { animation: rise 700ms var(--ease-out) both; }
    .copy > :nth-child(2) { animation-delay: 120ms; }
    .copy > :nth-child(3) { animation-delay: 180ms; }
    .copy > :nth-child(4) { animation-delay: 240ms; }
    .copy > :nth-child(5) { animation-delay: 300ms; }
  }
  @keyframes ribbon-in { from { opacity: 0; transform: translateX(var(--from)); } }
  @keyframes disc-in { from { opacity: 0; transform: translateY(14px) scale(0.96); } }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) {
    .ribbon img, .disc img, .copy > * { animation: fade 400ms ease both; }
  }
  @keyframes fade { from { opacity: 0; } }

  /* scroll parallax: scroll-driven CSS runs off the main thread; browsers without it just show the still picture */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ribbon, .disc {
        animation: parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .d1 { --shift: -60px; }
      .d2 { --shift: -140px; }
      .d3 { --shift: -240px; }
      .disc { --shift: 90px; --scale: 0.92; }
    }
  }
  @keyframes parallax { to { transform: translate3d(0, var(--shift), 0) scale(var(--scale, 1)); } }

  @media (max-width: 720px) {
    .hero { min-height: auto; padding: 72px 16px 80px; }
    .r-purple { left: -18%; top: -2%; width: 62vw; }
    .r-blue { right: -20%; top: 2%; width: 58vw; }
    .r-green { display: none; }
    .r-yellow { left: -2%; bottom: -6%; width: 26vw; }
    .r-red { right: -24%; bottom: 0; width: 66vw; }
    .kinds { display: none; }
  }

  @media (hover: hover) and (pointer: fine) {
    .cta:hover { opacity: 0.88; }
    .cta.ghost:hover { opacity: 1; border-color: var(--muted); }
  }
  /* ---------- about ---------- */
  .about { display: grid; gap: 64px; max-width: 1100px; margin: 0 auto; padding: 24px 32px 24px; scroll-margin-top: 96px; }
  .eyebrow { margin: 0 0 14px; color: var(--muted); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  h2 { margin: 0 0 10px; font-size: 22px; font-weight: 700; line-height: 1.25; letter-spacing: -0.02em; text-wrap: balance; }
  .lead { margin: 0; max-width: 36em; font-size: clamp(20px, 2.5vw, 28px); font-weight: 500; line-height: 1.4; letter-spacing: -0.015em; text-wrap: pretty; }
  .stats { display: flex; flex-wrap: wrap; gap: 20px 48px; margin: 36px 0 0; padding: 0; list-style: none; }
  .stats li { min-width: 120px; padding-top: 12px; border-top: 3px solid var(--c); }
  .stats b { display: block; font-size: 44px; font-weight: 800; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .stats span { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }

  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px; }
  .panel { padding: 28px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .panel p { margin: 0; color: var(--muted); text-wrap: pretty; }
  .ico {
    display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 18px; border-radius: 12px;
    color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .ico svg { width: 22px; height: 22px; }
  .nots ul { display: grid; gap: 10px; margin: 14px 0 0; padding: 0; list-style: none; }
  .nots li { display: flex; gap: 12px; align-items: baseline; }
  .nots li::before { content: "✕"; flex: none; color: var(--c); font-size: 12px; }

  .author { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 36px; align-items: center; }
  .author img { display: block; width: 100%; height: auto; }
  .author p:not(.eyebrow) { margin: 0; max-width: 60ch; color: var(--muted); text-wrap: pretty; }
  .author h2 { margin-bottom: 12px; font-size: 28px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .links a {
    display: inline-block; padding: 6px 14px; font-size: 14px; text-decoration: none;
    border: 1px solid var(--line); border-radius: 99px;
    transition: background-color 150ms ease, transform 160ms var(--ease-out);
  }
  .links a:active { transform: scale(0.97); }

  .join {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px;
    padding: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r);
  }
  .join h2 { max-width: 24ch; margin-bottom: 8px; font-size: 24px; }
  .join p { margin: 0; max-width: 56ch; color: var(--muted); text-wrap: pretty; }
  .join .cta { margin: 0; }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover { background: var(--surface-2); }
  }
  @media (max-width: 900px) {
    .about { gap: 48px; padding: 16px 16px 8px; }
    .duo, .split { grid-template-columns: 1fr; }
    .panel { padding: 22px; }
    .author { grid-template-columns: 1fr; gap: 20px; }
    .author img { width: 110px; }
    .join { padding: 24px 22px; }
  }
</style>
