---
import Base from "../../layouts/Base.astro";
import MiniHero from "../../components/MiniHero.astro";
import { organizations, eventsOf, eventsWord, url, coverAttrs } from "../../lib/site";

const sorted = [...organizations].sort((a, b) => a.name.localeCompare(b.name, "uk"));
---

<Base title="Організації — Events Lviv" description="Організації, які проводять щорічні події у Львові, та їхні події." current="organizations">
  <MiniHero title="Організації" />
  <div class="pagehead">
    <p>{organizations.length} організацій, які проводять події у Львові</p>
  </div>

  <main class="grid">
    {sorted.map((o) => {
      const n = eventsOf(o.id).length;
      return (
        <article class="card">
          <div {...coverAttrs(o.logo)}>
            <img src={url(o.logo)} alt="" loading="lazy" />
          </div>
          <div class="body">
            <h2><a href={url(`organizations/${o.id}/`)}>{o.name}</a></h2>
            <p class="desc">{o.description[0]}</p>
            <p class="count">{n} {eventsWord(n)}</p>
          </div>
        </article>
      );
    })}
  </main>
</Base>

<style>
  .card { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .cover { border-radius: var(--r) var(--r) 0 0; }
  /* the whole card is the click target */
  h2 a::after { content: ""; position: absolute; inset: 0; border-radius: var(--r); }
  h2 { margin: 0; font-size: 18px; font-weight: 700; line-height: 1.25; }
  h2 a { text-decoration: none; }
  .body { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 16px; }
  .desc { margin: 0; color: var(--muted); font-size: 13px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .count { margin: auto 0 0; padding-top: 6px; font-size: 13px; }
</style>
