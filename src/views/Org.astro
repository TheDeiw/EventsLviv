---
import Base from "../layouts/Base.astro";
import EventCard from "../components/EventCard.astro";
import LinkList from "../components/LinkList.astro";
import { content, href, url, coverAttrs, clip, crumbs, reportHref } from "../lib/site";
import { langOf, t, fill } from "../i18n/ui";

const { id } = Astro.props;
const lang = langOf(Astro);
const T = t(lang);
const { organizations, eventsOf } = content(lang);
const o = organizations.find((x) => x.id === id)!;
const events = eventsOf(o.id).sort((a, b) => a.name.localeCompare(b.name, lang));
const spaces = o.spaces ?? [];
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
// what search engines read about the organization: its site, logo and profiles elsewhere
const site = o.links.find((l) => l.type === "site");
const ld = [
  {
    "@type": "Organization",
    name: o.name,
    description: o.description[0],
    logo: abs(url(o.logo)),
    ...(site && { url: site.url }),
    sameAs: o.links.filter((l) => l !== site).map((l) => l.url),
  },
  crumbs(Astro.site, [[T("nav.home"), href(lang)], [T("nav.orgs"), href(lang, "organizations/")], [o.name, href(lang, `organizations/${o.id}/`)]]),
];
---

<Base title={fill(T("org.metaTitle"), { name: o.name })} description={clip(o.description[0])} current="organizations" path={`organizations/${o.id}/`} image={`og/org-${o.id}.jpg`} jsonld={ld}>
  <div class="org">
    <a class="back" href={href(lang, "organizations/")}>{T("orgs.back")}</a>

    <div class="head">
      <div {...coverAttrs(o.logo)}>
        <img src={url(o.logo)} alt={fill(T("logo.alt"), { name: o.name })} />
      </div>
      <div>
        <h1>{o.name}</h1>
        {o.description.map((p: string) => <p class="text">{p}</p>)}
        {o.links.length > 0 && <div class="links"><LinkList links={o.links} /></div>}
        <a class="report" href={reportHref(lang, `organizations/${o.id}/`)}>{T("fb.report")}</a>
      </div>
    </div>

    {spaces.length > 0 && (
      <section>
        <h2>{T("org.spaces")}</h2>
        <ul class="spaces">
          {spaces.map((s) => (
            <li>
              <div {...coverAttrs(s.logo)}><img src={url(s.logo)} alt="" loading="lazy" /></div>
              <span>{s.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2>{T("org.events")}</h2>
  </div>
  <main class="grid" id="grid">
    {events.map((e) => <EventCard event={e} />)}
  </main>
</Base>

<style>
  .org { max-width: 1280px; margin: 0 auto; padding: 20px 32px 0; }
  .head { display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 1fr); gap: 40px; align-items: start; }
  .cover { border-radius: var(--r); }
  h1 { margin: 0 0 12px; font-size: clamp(28px, 4vw, 40px); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
  h2 { margin: 36px 0 12px; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .text { margin: 0 0 12px; max-width: 70ch; white-space: pre-line; }
  .links { margin-top: 20px; }
  .report { display: inline-block; margin-top: 14px; font-size: 13px; color: var(--muted); text-underline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .report:hover { color: var(--text); } }
  .spaces { padding: 0; list-style: none; }
  .spaces { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .spaces .cover { aspect-ratio: 1; }
  .spaces span { display: block; margin-top: 6px; font-size: 13px; }
  @media (max-width: 800px) {
    .head { grid-template-columns: 1fr; gap: 20px; }
  }
  /* same breakpoint as the .grid padding, so the heading lines up with the cards */
  @media (max-width: 600px) {
    .org { padding: 16px 16px 0; }
  }
</style>
