---
import Base from "../layouts/Base.astro";
import MiniHero from "../components/MiniHero.astro";
import LinkList from "../components/LinkList.astro";
import { langOf, t } from "../i18n/ui";

const lang = langOf(Astro);
const T = t(lang);
const en = lang === "en";
// where to look up dates and tickets; the titles are brand names, only a few differ by language
// logo: public/images/calendar/<logo>.png, a one-colour mask cut from the service's favicon (the mark is what differs from its background)
const L = (title: string, url: string, logo: string, uk: string, enNote: string, type = "site") => ({ title, url, type, logo, note: en ? enNote : uk });
const SECTIONS = [
  {
    title: T("cal.general"),
    links: [
      L("Lviv.travel", "https://lviv.travel/ua/events", "lviv-travel", "Офіційний туристичний портал Львова: фестивалі, концерти, виставки й міські свята.", "Lviv's official tourism portal: festivals, concerts, exhibitions and city holidays."),
      L("LvivGo", "https://lvivgo.com.ua", "lvivgo", "Афіша на сьогодні, вихідні й місяць наперед, з датами, цінами й квитками.", "Listings for today, the weekend and the month ahead, with dates, prices and tickets."),
      L("Allevents", "https://allevents.in/lviv-ua", "allevents", "Міжнародний агрегатор, що збирає анонси з багатьох джерел, зокрема з Facebook.", "An international aggregator that gathers listings from many sources, Facebook included."),
      L("Karabas", "https://lviv.karabas.com", "karabas", "Квитковий сервіс: концерти, театр, стендап і фестивалі.", "Ticket service for concerts, theatre, stand-up and festivals."),
      L("Kontramarka", "https://lviv.kontramarka.ua/uk", "kontramarka", "Квитковий сервіс з афішею Львова: куди піти сьогодні й на вихідних.", "Ticket service with a Lviv listing: where to go today and at the weekend."),
      L("Concert.ua", "https://concert.ua/uk/catalog/lviv/all-categories", "concert-ua", "Один з найбільших квиткових сервісів України: концерти, вистави й фестивалі у Львові.", "One of Ukraine's largest ticket services: concerts, shows and festivals in Lviv."),
      L("LEM Station", "https://lemstation.com/event-platform/", "lem-station", "Івент-простір на 500 м², де проходять конференції, виставки та інші заходи.", "A 500 m² event venue that hosts conferences, exhibitions and more."),
    ],
  },
  {
    title: T("cal.it"),
    links: [
      L(en ? "DOU: IT events in Lviv" : "DOU: IT-події у Львові", "https://dou.ua/calendar/city/Lviv/", "dou", "Календар найбільшої спільноти українських розробників: мітапи, конференції, воркшопи.", "The calendar of Ukraine's largest developer community: meetups, conferences, workshops."),
      L("Lviv IT Cluster", "https://itcluster.lviv.ua/podiyi/", "it-cluster", "Події IT-кластера, серед них IT Arena, та новини галузі.", "Events from the city's IT cluster, IT Arena among them, plus industry news."),
    ],
  },
  {
    title: T("cal.uni"),
    links: [L(en ? "Lviv Polytechnic" : "Львівська політехніка", "https://lpnu.ua/events", "lpnu", "Що незабаром відбудеться в університеті: лекції, конференції, дні відкритих дверей.", "What's coming up at the university: lectures, conferences, open days.")],
  },
  {
    title: T("cal.telegram"),
    links: [
      L(en ? "Tvory: Easy Lviv" : "Твори ізі Львів", "https://t.me/easyLviv", "", "Канал для молоді: події, волонтерство, освітні програми й нові знайомства.", "A channel for young people: events, volunteering, education programmes and new people to meet.", "telegram"),
      L("!FESTrepublic", "https://t.me/FESTrepublic", "", "Анонси фестивалів !FESTrepublic, знижки, промокоди та історії з-за лаштунків.", "!FESTrepublic festival news, discounts, promo codes and backstage stories.", "telegram"),
    ],
  },
];
---

<Base title={T("cal.metaTitle")} description={T("cal.metaDesc")} current="calendar" path="calendar/">
  <MiniHero title={T("cal.title")} />
  <main class="cal">
    <p class="lead">{T("cal.lead")}</p>
    {SECTIONS.map((s) => (
      <section>
        <h2>{s.title}</h2>
        <LinkList links={s.links} mono />
      </section>
    ))}
  </main>
</Base>

<style>
  .cal { max-width: 1000px; margin: 0 auto; padding: 32px 32px 64px; }
  .lead { margin: 0 0 8px; font-size: 18px; line-height: 1.6; text-wrap: pretty; }
  h2 { margin: 36px 0 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 600px) {
    .cal { padding: 20px 16px 48px; }
    .lead { font-size: 16px; }
    h2 { margin-top: 28px; }
  }
</style>
