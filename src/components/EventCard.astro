---
import Icon from "./Icon.astro";
import { content, href, url, when, coverAttrs, entryLabel } from "../lib/site";
import { langOf, t } from "../i18n/ui";

const { event: e } = Astro.props;
const lang = langOf(Astro);
const T = t(lang);
const { orgName, topicById } = content(lang);
// search matches the name and organizer in both languages, so "Молодвіж" finds the event on the English page too
const other = content(lang === "uk" ? "en" : "uk");
const q = [e.name, other.events.find((x) => x.id === e.id)?.name, e.organizationId && orgName[e.organizationId], e.organizationId && other.orgName[e.organizationId]]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
const titleId = `t-${e.id}`;
---

<article
  class="card"
  style={`--tc:${topicById[e.topics[0]].color}`}
  data-topics={e.topics.join(",")}
  data-months={e.months.join(",")}
  data-yr={e.yearRound ? "1" : undefined}
  data-entry={e.entry}
  data-org={e.organizationId}
  data-q={q}
>
  <a class="link" href={href(lang, `events/${e.id}/`)} aria-labelledby={titleId}>
    <div {...coverAttrs(e.cover, e.coverBg)}>
      <img src={url(e.cover)} alt="" loading="lazy" />
    </div>
    <div class="body">
      <h3 id={titleId}>{e.name}</h3>
      <div class="tags">
        {e.topics.map((t: string) => <span class="tag" style={`--tc:${topicById[t].color}`}>{topicById[t].name}</span>)}
      </div>
      <p class="desc">{e.description[0]}</p>
      <div class="bottom">
      <ul class="facts">
        {e.organizationId && (
          <li class="org">
            <Icon name="building" />
            <span><span class="sr">{T("card.org")}</span>{orgName[e.organizationId]}</span>
          </li>
        )}
        <li>
          <Icon name="calendar" />
          <span><span class="sr">{T("card.when")}</span>{when(e, lang)}</span>
        </li>
        <li class={`price ${e.entry}`}>
          <Icon name="ticket" />
          <span><span class="sr">{T("card.entry")}</span>{entryLabel(lang, e.entry)}</span>
        </li>
      </ul>
      <span class="go" aria-hidden="true">
        <Icon name="arrow" />
      </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    --edge: var(--line);
    background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r);
    transition: background-color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }
  /* the whole card is one link; its name comes from the title only */
  .link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; border-radius: inherit; }
  .link:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .cover { aspect-ratio: 16 / 9; border-radius: calc(var(--r) - 1px) calc(var(--r) - 1px) 0 0; }
  .cover::after { display: none; } /* the card border already outlines it */
  .cover img { transition: transform 300ms var(--ease-out); }
  .body { position: relative; flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 18px 20px 20px; border-top: 2px dashed var(--edge); }
  /* ticket notches on the perforation line */
  .body::before, .body::after {
    content: ""; position: absolute; top: -9px; width: 16px; height: 16px; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--edge); transition: border-color 200ms ease;
  }
  .body::before { left: -9px; clip-path: inset(0 0 0 50%); }
  .body::after { right: -9px; clip-path: inset(0 50% 0 0); }
  h3 { margin: 0; font-size: 20px; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }
  p { margin: 0; }
  .tags { margin-top: -4px; }
  .desc {
    color: var(--muted); font-size: 14px; line-height: 1.5;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .facts { display: grid; gap: 8px; margin: 2px 0 0; padding: 0; list-style: none; }
  .facts li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; line-height: 1.35; }
  .facts li > span { min-width: 0; }
  .facts .org > span { font-weight: 500; }
  .facts :global(svg) { flex: none; width: 17px; height: 17px; color: var(--muted); }
  .bottom { margin-top: auto; padding-top: 6px; display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }
  .bottom .facts { flex: 1; min-width: 0; }
  /* corner arrow: says "this opens" */
  .go {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    color: var(--text); border: 1px solid var(--line);
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .go :global(svg) { width: 16px; height: 16px; stroke-width: 2; transition: transform 200ms var(--ease-out); }
  .card:active { transform: scale(0.985); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover { --edge: color-mix(in srgb, var(--tc) 55%, var(--line)); background: color-mix(in srgb, var(--tc) 9%, var(--surface)); }
    .card:hover .cover img { transform: scale(1.03); }
    .card:hover .go { background: var(--tc); border-color: var(--tc); color: #111; }
    .card:hover .go :global(svg) { transform: translate(2px, -2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .cover img, .go :global(svg) { transition-property: background-color, border-color, color; }
    .card:active, .card:hover .cover img, .card:hover .go :global(svg) { transform: none; }
  }
</style>
