---
import { content } from "../lib/site";
import { langOf, t } from "../i18n/ui";

const lang = langOf(Astro);
const T = t(lang);
const { events, organizations, topics } = content(lang);

const ENTRY_CHIPS = [["", T("f.any")], ["free", T("f.free")], ["paid", T("f.paid")]];
const WHEN_CHIPS = [["", T("f.year")], ["spring", T("f.spring")], ["summer", T("f.summer")], ["autumn", T("f.autumn")], ["winter", T("f.winter")]];
const orgs = organizations
  .map((o) => ({ id: o.id, name: o.name, n: events.filter((e) => e.organizationId === o.id).length }))
  .filter((o) => o.n > 0)
  .sort((a, b) => a.name.localeCompare(b.name, lang));
const inTopic = (id: string) => events.filter((e) => e.topics.includes(id)).length;
---

<div class="filters">
  <label class="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input type="search" placeholder={T("f.search")} aria-label={T("f.searchAria")} autocomplete="off" />
  </label>

  <div class="group" role="group" aria-labelledby="f-topic">
    <h3 id="f-topic">{T("f.topic")}</h3>
    <button class="opt" data-filter="topic" data-value="" aria-pressed="true">
      <span class="dot" style="--tc:var(--muted)"></span>{T("f.all")}<span class="n">{events.length}</span>
    </button>
    {topics.map((t) => (
      <button class="opt" data-filter="topic" data-value={t.id} aria-pressed="false">
        <span class="dot" style={`--tc:${t.color}`}></span>{t.name}<span class="n">{inTopic(t.id)}</span>
      </button>
    ))}
  </div>

  <div class="group">
    <h3 id="f-org"><label for="org-select">{T("f.org")}</label></h3>
    <div class="select">
      <select id="org-select" data-filter-org>
        <option value="">{T("f.allOrgs")}</option>
        {orgs.map((o) => <option value={o.id}>{o.name} ({o.n})</option>)}
      </select>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </div>
  </div>

  <div class="group" role="group" aria-labelledby="f-entry">
    <h3 id="f-entry">{T("f.entry")}</h3>
    <div class="chips">
      {ENTRY_CHIPS.map(([v, name], i) => <button class="chip" data-filter="entry" data-value={v} aria-pressed={String(i === 0)}>{name}</button>)}
    </div>
  </div>

  <div class="group" role="group" aria-labelledby="f-when">
    <h3 id="f-when">{T("f.when")}</h3>
    <div class="chips">
      {WHEN_CHIPS.map(([v, name], i) => <button class="chip" data-filter="when" data-value={v} aria-pressed={String(i === 0)}>{name}</button>)}
    </div>
  </div>
</div>

<style>
  .filters { display: grid; gap: 16px; }
  .search { position: relative; display: block; }
  .search svg { position: absolute; left: 12px; top: 50%; width: 17px; height: 17px; translate: 0 -50%; color: var(--muted); pointer-events: none; }
  input {
    width: 100%; height: 40px; padding: 0 12px 0 38px; font: inherit; font-size: 16px; color: var(--text);
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
  }
  input::placeholder { color: var(--muted); }
  .select { position: relative; }
  select {
    width: 100%; height: 40px; padding: 0 36px 0 12px; font: inherit; font-size: 14px; color: var(--text); cursor: pointer;
    text-overflow: ellipsis; appearance: none; -webkit-appearance: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    transition: border-color 150ms ease;
  }
  .select svg { position: absolute; right: 12px; top: 50%; width: 16px; height: 16px; translate: 0 -50%; color: var(--muted); pointer-events: none; }
  h3 label { cursor: pointer; }
  h3 { margin: 0 0 6px; color: var(--muted); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .opt {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 10px; cursor: pointer;
    font-size: 14px; text-align: left; color: var(--muted); background: transparent; border: 0; border-radius: 10px;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--tc); }
  .n { margin-left: auto; font-size: 12px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .opt[aria-pressed="true"] { color: var(--text); background: var(--surface-2); font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 4px 11px; cursor: pointer; font-size: 13px; color: var(--text);
    background: transparent; border: 1px solid var(--line); border-radius: 99px;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .chip[aria-pressed="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  /* tighter rows on desktop so the sticky sidebar fits a laptop screen without its own scrollbar */
  @media (min-width: 901px) { .opt { padding-block: 4px; } }
  @media (hover: hover) and (pointer: fine) {
    .opt:not([aria-pressed="true"]):hover { color: var(--text); background: color-mix(in srgb, var(--surface-2) 55%, transparent); }
    .chip:not([aria-pressed="true"]):hover, select:hover { border-color: var(--muted); }
  }
</style>
